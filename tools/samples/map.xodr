                <right><lane id="-1" type="driving" level="false"><width sOffset="0.0" a="3.5" b="0.0" c="0.0" d="0.0"/></lane></right>
            </laneSection>
        </lanes>
    </road>

    <!-- ========================================== -->
    <!-- 8. 立交匝道：重点复现西南角大型环形匝道 -->
    <!-- 使用 ARC 模拟大曲率环岛 -->
    <!-- ========================================== -->
    <road name="Ramp_SW_Loop" length="300.0" id="8" junction="-1">
        <planView>
            <!-- 起点在时代高架西侧，向南绕行，最终接入江南大道 -->
            <geometry s="0.0" x="-30.0" y="-200.0" hdg="-1.570796" length="300.0">
                <!-- 大曲率圆弧，模拟环岛匝道 -->
                <arc curvature="0.025"/>
            </geometry>
        </planView>
        <elevationProfile>
            <!-- 匝道高程从 6m 渐变为 0m 接地 -->
            <elevation s="0.0" a="6.0" b="0.0" c="0.0" d="0.0"/>
            <elevation s="300.0" a="0.0" b="0.0" c="0.0" d="0.0"/>
        </elevationProfile>
        <lanes>
            <laneSection s="0.0">
                <center><lane id="0" type="none" level="true"/></center>
                <right><lane id="-1" type="driving" level="true"><width sOffset="0.0" a="3.5" b="0.0" c="0.0" d="0.0"/></lane></right>
            </laneSection>
        </lanes>
    </road>

    <!-- ========================================== -->
    <!-- 9. 立交匝道：东北角定向匝道 -->
    <!-- ========================================== -->
    <road name="Ramp_NE" length="200.0" id="9" junction="-1">
        <planView>
            <!-- 起点在江南大道高架，向北绕行接入时代高架 -->
            <geometry s="0.0" x="150.0" y="50.0" hdg="0.12" length="200.0">
                <arc curvature="-0.02"/>
            </geometry>
        </planView>
        <elevationProfile>
            <elevation s="0.0" a="6.0" b="0.0" c="0.0" d="0.0"/>
            <elevation s="200.0" a="6.0" b="0.0" c="0.0" d="0.0"/>
        </elevationProfile>
        <lanes>
