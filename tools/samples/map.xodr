<?xml version="1.0" encoding="UTF-8"?>
<OpenDRIVE>
    <header revMajor="1" revMinor="4" name="Zhongxing_Interchange" version="1.0" date="2024-05-21" north="30.2100" south="30.1950" east="120.2250" west="120.2100">
        <geoReference><![CDATA[+proj=tmerc +lat_0=30.2 +lon_0=120.2 +k=1 +x_0=0 +y_0=0 +ellps=WGS84 +units=m +no_defs]]></geoReference>
    </header>

    <!-- ========================================== -->
    <!-- 1. 高架道路：时代高架 (南北向，主干道) -->
    <!-- 高程：从 0m 爬坡至 6m，维持，再下坡 -->
    <!-- ========================================== -->
    <road name="Shidai_Elevated" length="1000.0" id="1" junction="-1">
        <planView>
            <!-- 起点在 (0, -500)，航向正北 (1.5708) -->
            <geometry s="0.0" x="0.0" y="-500.0" hdg="1.570796" length="1000.0">
                <line/>
            </geometry>
        </planView>
        <elevationProfile>
            <!-- 0-150m 爬坡 -->
            <elevation s="0.0" a="0.0" b="0.04" c="0.0" d="0.0"/>
            <!-- 150-850m 保持 6m 高度 -->
            <elevation s="150.0" a="6.0" b="0.0" c="0.0" d="0.0"/>
            <!-- 850-1000m 下坡 -->
            <elevation s="850.0" a="6.0" b="-0.04" c="0.0" d="0.0"/>
        </elevationProfile>
        <lanes>
            <laneSection s="0.0">
                <left>
                    <lane id="1" type="driving" level="true"><width sOffset="0.0" a="3.75" b="0.0" c="0.0" d="0.0"/></lane>
                    <lane id="2" type="driving" level="true"><width sOffset="0.0" a="3.75" b="0.0" c="0.0" d="0.0"/></lane>
                </left>
                <center><lane id="0" type="none" level="true"/></center>
                <right>
                    <lane id="-1" type="driving" level="true"><width sOffset="0.0" a="3.75" b="0.0" c="0.0" d="0.0"/></lane>
                    <lane id="-2" type="driving" level="true"><width sOffset="0.0" a="3.75" b="0.0" c="0.0" d="0.0"/></lane>
                </right>
            </laneSection>
        </lanes>
    </road>

    <!-- ========================================== -->
    <!-- 2. 高架道路：江南大道 (东西向，斜交) -->
    <!-- 注意：航向角设为 0.12 弧度，模拟地图中的倾斜 -->
    <!-- ========================================== -->
    <road name="Jiangnan_Elevated" length="1000.0" id="2" junction="-1">
        <planView>
            <!-- 起点在 (-500, -60)，向东偏北方向延伸 -->
            <geometry s="0.0" x="-500.0" y="-60.0" hdg="0.12" length="1000.0">
                <line/>
            </geometry>
        </planView>
        <elevationProfile>
            <elevation s="0.0" a="0.0" b="0.04" c="0.0" d="0.0"/>
            <elevation s="150.0" a="6.0" b="0.0" c="0.0" d="0.0"/>
            <elevation s="850.0" a="6.0" b="-0.04" c="0.0" d="0.0"/>
        </elevationProfile>
        <lanes>
            <laneSection s="0.0">
                <left>
                    <lane id="1" type="driving" level="true"><width sOffset="0.0" a="3.75" b="0.0" c="0.0" d="0.0"/></lane>
                    <lane id="2" type="driving" level="true"><width sOffset="0.0" a="3.75" b="0.0" c="0.0" d="0.0"/></lane>
                </left>
                <center><lane id="0" type="none" level="true"/></center>
                <right>
                    <lane id="-1" type="driving" level="true"><width sOffset="0.0" a="3.75" b="0.0" c="0.0" d="0.0"/></lane>
                    <lane id="-2" type="driving" level="true"><width sOffset="0.0" a="3.75" b="0.0" c="0.0" d="0.0"/></lane>
                </right>
            </laneSection>
        </lanes>
    </road>

    <!-- ========================================== -->
