    <!-- ========================================== -->
    <!-- 7. 周边道路：江晖路 (东侧南北向) -->
    <!-- ========================================== -->
    <road name="Jianghui_Road" length="1000.0" id="7" junction="-1">
        <planView>
            <geometry s="0.0" x="250.0" y="-500.0" hdg="1.570796" length="1000.0"><line/></geometry>
        </planView>
        <lanes>
            <laneSection s="0.0">
                <left><lane id="1" type="driving" level="false"><width sOffset="0.0" a="3.5" b="0.0" c="0.0" d="0.0"/></lane></left>
