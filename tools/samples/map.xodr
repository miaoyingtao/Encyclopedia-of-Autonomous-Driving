    <road name="Binsheng_Road" length="1000.0" id="5" junction="-1">
        <planView>
            <geometry s="0.0" x="-500.0" y="-250.0" hdg="0.12" length="1000.0"><line/></geometry>
        </planView>
        <lanes>
